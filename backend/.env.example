# Copy this file to .env and fill in your values

DATABASE_URL=sqlite+aiosqlite:///./orbi.db
SECRET_KEY=change-me-in-production
DEBUG=true

# SFTP settings (leave blank for MVP local dev)
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_DROP_PATH=/drop
SFTP_ARCHIVE_PATH=/archive
SFTP_POLL_INTERVAL_SECONDS=300
